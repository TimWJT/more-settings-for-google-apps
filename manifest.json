{
  "manifest_version": 3,
  "name": "More Settings for Google Docs",
  "version": "1.0.0",
  "description": "Fast dark mode for Google Docs, Sheets, Slides, Forms, Drive, Calendar and Keep, plus clean-up options like hiding Gemini and the side panel.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_icon": "icon.svg",
    "default_popup": "popup.html",
    "default_title": "More Settings for Google Docs"
  },
  "background": {
    "scripts": [
      "settings.js",
      "background.js"
    ]
  },
  "commands": {
    "toggle-dark": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Turn dark mode on or off"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://docs.google.com/*",
    "*://drive.google.com/*",
    "*://calendar.google.com/*",
    "*://keep.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://docs.google.com/*",
        "*://drive.google.com/*",
        "*://calendar.google.com/*",
        "*://keep.google.com/*"
      ],
      "css": [
        "dark.css"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "more-settings-for-google-docs@timwjt",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
