{
  "manifest_version": 3,
  "name": "More Settings for Google Apps",
  "version": "1.0.0",
  "description": "Fast dark mode for Google Docs, Sheets, Slides, Forms and Gmail (emails included), with your own page colours, plus clean-up options like hiding Gemini and the side panel.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_icon": "icon.svg",
    "default_popup": "popup.html",
    "default_title": "More Settings for Google Apps"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://docs.google.com/*",
    "*://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://docs.google.com/*",
        "*://mail.google.com/*"
      ],
      "css": [
        "dark.css"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "more-settings-for-google-apps@timwjt",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
